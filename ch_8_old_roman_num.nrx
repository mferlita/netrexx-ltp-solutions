/* This method when passed a number between 1 and 3,999 converts it to roman
 numerals (without subtractive notation like IV and IX). */

SAY oldNum(1984)
SAY
SAY oldNum(984)
SAY
SAY oldNum(84)
SAY
SAY oldNum(4)
SAY
SAY oldNum(1999) -- From answer key. Should be MDCCCCLXXXXVIIII
SAY
SAY oldNum(1992)
SAY
SAY oldNum(2004)
SAY

-- The following are from Wikipedia, retrieved 9/22/26.
SAY oldNum(39)
SAY
SAY oldNum(246)
SAY
SAY oldNum(789)
SAY
SAY oldNum(2421)
SAY
SAY oldNum(160)
SAY
SAY oldNum(207)
SAY
SAY oldNum(1009)
SAY
SAY oldNum(1066)
SAY
SAY oldNum(1776)
SAY
SAY oldNum(1918)
SAY
SAY oldNum(1944)
SAY
SAY oldNum(2026)
SAY
SAY oldNum(3999)
--SAY
--SAY oldNum(0)
--SAY
--SAY oldNum(4001)

/* Directives */
METHOD oldNum(num) STATIC
  IF (num <= 0) | (num >= 4000) THEN
    signal RuntimeException('Must use a positive integer less than 4,000')

  digit4 = num.right(4,0)

  roman = "M".copies(digit4.charAt(0))
  roman = roman || "D".copies(digit4.charAt(1) % 5)
  roman = roman || "C".copies(digit4.charAt(1) // 5)
  roman = roman || "L".copies(digit4.charAt(2) % 5)
  roman = roman || "X".copies(digit4.charAt(2) // 5)
  roman = roman || "V".copies(digit4.charAt(3) % 5)
  roman = roman || "I".copies(digit4.charAt(3) // 5)

  SAY num
  RETURN roman
