/* Chapter 7 */

-- Some arrays
numberArray1 = [0]
numberArray2 = [5, 8, 2]
stringyArray = ["Hello", "Goodbye"]
--anArrayOfArrays = [Rexx(anArray), Rexx(anotherArray)]
andAnotherAndAnother = [["Strawberry", "Raspberry"], ["Apples", "Oranges"]]

-- You cannot mix types in arrays. An array must contain the same type
-- throughout

gems = String[3]
gems[0] = "Pearl"
gems[1] = "Garnet"
gems[2] = "Amethyst"

SAY gems[0]
SAY gems[1]
SAY gems[2]
--SAY gems[3] --This is out of range and won't work                                            
SAY

other_gems = String[3]                       
other_gems[2] = "Ruby"
other_gems[0] = "Pink Diamond"
other_gems[1] = "Sapphire"
other_gems[0] = "Rose Quartz"

LOOP index OVER other_gems
	SAY index
END

SAY 
SAY "Or do this:"
SAY Rexx(other_gems)
SAY

-- My First Iterator
languages = String[3]
languages[0] = "English"
languages[1] = "Norwegian"
languages[2] = "Ruby"

LOOP lang OVER languages
    SAY "I love" lang || "! Don't you?"
END

SAY "And let's hear it for Fortran!"
SAY "<crickets chirp in the distance>"
SAY

-- integer method FTW
LOOP FOR 3
  SAY "Hip-Hip-Hooray!"
END

SAY

LOOP FOR 2
  SAY "...you can SAY that again..."
END
SAY

-- More Array Methods
foods = String[3]
foods[0] = "artichoke"
foods[1] = "brioche"
foods[2] = "caramel"

SAY Rexx(foods)
SAY                    
SAY Rexx(foods).changestr(" ",", ")
SAY
SAY Rexx(foods).changestr(" "," :) ") || " 8)"
SAY

gems_langs_foods = [Rexx(gems), Rexx(languages), Rexx(foods)]

LOOP index OVER gems_langs_foods
 SAY index
END


-- Basically, arrays in NetRexx are a pain and are not fun at all.
-- I might not continue with this. In order to more easily use arrays, I would
-- have to add to the language itself or make my own classes and methods using
-- Java. If I have to use Java, what's the point of an alternative language for
-- the JVM?

