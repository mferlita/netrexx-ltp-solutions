/* Chapter 7 */

-- NetRexx arrays map directly onto Java arrays, which are great for performance
-- but can be difficult to work with. In practice, it seems most Java
-- programmers use ArrayList, which is built on top of the low-level Java 
-- arrays. Here, I've tried to exhibit both in NetRexx to the best of my 
-- understanding.

-- Some arrays
numberArray1 = [0]
numberArray2 = [5, 8, 2]
stringyArray = ["Hello", "Goodbye"]
anArrayOfArrays = [["Strawberry", "Raspberry"], ["Apples", "Oranges"]]

-- Using SAY doesn't work for printing out the contents.
--SAY numberArray2
--SAY stringyArray
--SAY anArrayOfArrays

LOOP index OVER stringyArray
 SAY index
END

SAY

-- You cannot mix types in arrays. An array must contain the same type
-- throughout.

gems = String[3]
gems[0] = "Pearl"
gems[1] = "Garnet"
gems[2] = "Amethyst"

SAY gems[0]
SAY gems[1]
SAY gems[2]
--SAY gems[3] --This is out of range and won't work                                            
SAY

other_gems = String[3]                       
other_gems[2] = "Ruby"
other_gems[0] = "Pink Diamond"
other_gems[1] = "Sapphire"
other_gems[0] = "Rose Quartz"

LOOP index OVER other_gems
	SAY index
END

SAY 
SAY "Or do this:"
SAY Rexx(other_gems)
SAY

-- My First Iterator
languages = String[3]
languages[0] = "English"
languages[1] = "Norwegian"
languages[2] = "Ruby"

LOOP lang OVER languages
    SAY "I love" lang || "! Don't you?"
END

SAY "And let's hear it for Fortran!"
SAY "<crickets chirp in the distance>"
SAY

-- integer method FTW
LOOP FOR 3
  SAY "Hip-Hip-Hooray!"
END

SAY

LOOP FOR 2
  SAY "...you can SAY that again..."
END
SAY

-- More Array Methods
foods = String[3]
foods[0] = "artichoke"
foods[1] = "brioche"
foods[2] = "caramel"

SAY Rexx(foods)
SAY                    
SAY Rexx(foods).changestr(" ",", ")
SAY
SAY Rexx(foods).changestr(" "," :) ") || " 8)"
SAY

gems_langs_foods = [Rexx(gems), Rexx(languages), Rexx(foods)]

LOOP index OVER gems_langs_foods
 SAY index
END

/* ArrayList */
gems1 = ArrayList()
gems1.add("Pearl")
gems1.add("Garnet")
gems1.add("Amethyst")

SAY
SAY "/* ArrayList */"
SAY gems1.get(0)
SAY gems1.get(1)
SAY gems1.get(2)
SAY

other_gems1 = ArrayList()
--populate the array
other_gems1.add("Pearl")
other_gems1.add("Garnet")
other_gems1.add("Amethyst")

--then change the array
other_gems1.set(2, "Ruby")
other_gems1.set(0, "Pink Diamond")
other_gems1.set(1, "Sapphire")
other_gems1.set(0, "Rose Quartz")

--print out the contents of the array in the correct order
LOOP index = 0 to other_gems1.size() - 1
	SAY other_gems1.get(index)
END
SAY

-- My First Iterator for ArrayList
languages1 = ArrayList()
languages1.add("English")
languages1.add("Norwegian")
languages1.add("Ruby")

LOOP index = 0 to languages1.size() - 1
	SAY "I love" languages1.get(index) || "! Don't you?"
END

SAY "And let's hear it for Fortran!"
SAY "<crickets chirp in the distance>"
SAY


-- More Array Methods for ArrayList
foods1 = ArrayList()
foods1.add("artichoke")
foods1.add("brioche")
foods1.add("caramel")

SAY foods1
SAY                    
SAY String.join(", ", foods1)
SAY
SAY String.join(" :) ", foods1) || " 8)"
SAY

gems_langs_foods1 = ArrayList()
gems_langs_foods1.add(gems1)
gems_langs_foods1.add(languages1)
gems_langs_foods1.add(foods1)

LOOP index = 0 to gems_langs_foods1.size() - 1
	inner_list = java.util.ArrayList gems_langs_foods1.get(index)
	SAY String.join(", ", inner_list)
END
SAY

favorites = ArrayList()
favorites.add("raindrops on roses")
favorites.add("whiskey on kittens")

SAY favorites.get(0)
SAY favorites.getLast()
SAY favorites.size()

SAY favorites.removeLast
SAY favorites
SAY favorites.size

