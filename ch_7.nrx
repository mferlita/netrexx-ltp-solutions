/* Chapter 7 */

-- Some arrays
--anArray = Rexx[0]
--anotherArray = [5]
--andAnotherArray = ["Hello", "Goodbye"]
--
--flavor = "vanilla" -- Not an array, of course...
--flavorArray = [89.9, flavor, 'flavor'] -- ...but this is

gems = ["Pearl", "Garnet", "Amethyst"]

SAY gems[0]
SAY gems[1]
SAY gems[2]
--SAY gems[3] --This is out of range and won't work                                            
SAY

other_gems = String[3]                       
other_gems[2] = "Ruby"
other_gems[0] = "Pink Diamond"
other_gems[1] = "Sapphire"
other_gems[0] = "Rose Quartz"
LOOP index OVER other_gems
	SAY index
END
SAY              

-- My First Iterator
languages = ["English", "Norwegian", "Ruby"]

LOOP lang OVER languages
    SAY "I love" lang || "! Don't you?"
END

SAY "And let's hear it for Fortran!"
SAY "<crickets chirp in the distance>"
SAY

-- integer method FTW
LOOP FOR 3
  SAY "Hip-Hip-Hooray!"
END

SAY

LOOP FOR 2
  SAY "...you can SAY that again..."
END
SAY

-- More Array Methods
foods = ["artichoke", "brioche", "caramel"]
LOOP index OVER foods 
  SAY index              
END
SAY
--SAY foods.string -- this is like telling ooRexx "tell me what this object is." It will print out "an Array"
--SAY test.string
--SAY                       
--SAY foods.makeString("L", ", ")
--SAY
--SAY foods.makeString("L", " :) ") || " 8)"
--SAY

gems_langs_foods = [gems, languages, foods]

LOOP index OVER gems_langs_foods
  SAY index
END
SAY

