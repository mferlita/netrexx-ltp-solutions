/* Chapter 5 */

/* Fancy String Methods */
var1 = "stop"
var2 = "deliver repaid desserts"
var3 = "....TCELES B HSUP - A magic spell?"

SAY var1.reverse
SAY var2.reverse
SAY var3.reverse
SAY var1
SAY var2
SAY var3
SAY ""

SAY "What is your first name?"
f_name = ask
SAY "What is your middle name?"
m_name = ask
SAY "What is your last name?"
l_name = ask
SAY "Did you know there" f_name.length + m_name.length + l_name.length -
    "characters"
SAY "in your name," f_name m_name l_name"?"
SAY ""

letters = "aAbBcCdDeE"
SAY letters.upper "-- upper"
SAY letters.lower "-- lower"
-- NetRexx doesn't have a simple equivalent to these Ruby methods,
-- so we'll have to write our own.
-- puts letters.swapcase
-- puts letters.capitalize
-- puts "a".capitalize
SAY MattUtil.swapCase(letters) "-- swapcase"
SAY MattUtil.capitalize(letters) "-- capitalize"
SAY MattUtil.capitalize("a") "-- capitalize"
SAY letters
SAY ""

line_width = 50
SAY "Old Mother Hubbard".center(line_width)
SAY "Sat in her cupboard".center(line_width)
SAY "Eating her curds and whey,".center(line_width)
SAY "When along came a spider".center(line_width)
SAY "Who sat down beside her".center(line_width)
SAY "And scared her poor shoe dog away".center(line_width)
SAY ""

line_width = 40
str = "==> text <=="
SAY str.left(line_width)
SAY str.center(line_width)
SAY str.right(line_width)
SAY str.left(line_width/2) || str.right(line_width/2)
SAY ""

-- continued in ch_5_angry_boss.nrx and ch_5_table_of_contents.nrx

/* More Arithmetic */
SAY 5**2 --exponentiation
SAY 7 % 3 --integer division
SAY Math.floorMod(7,3) -- Java's modulus method gives remainder
SAY 7 // 3 -- gives remainder but not modulus
SAY Math.floorMod(365,7)
SAY ""

-- absolute value
SAY (5 - 2).abs
SAY (2 - 5).abs
SAY ""

-- Java's random number generator (one of them, anywho)
SAY Math.random()
SAY Math.random()
SAY Math.random()
SAY (Math.random() * 100).trunc
SAY (Math.random() * 100).trunc
SAY (Math.random() * 1).trunc
SAY (Math.random() * 1).trunc
SAY (Math.random() * 1).trunc
SAY (Math.random() * 2147483647).trunc -- 2,147,483,647 largest 'int' can do
SAY "My weather app says there is a"
SAY (Math.random() * 101).trunc || "% chance of rain,"
SAY "but it's literally raining right now!"
SAY

-- seeded
range = java.util.Random(1976)
SAY range.nextInt(100)
SAY range.nextInt(100)
SAY range.nextInt(100)
SAY range.nextInt(100)
SAY

range = java.util.Random(1976)
SAY range.nextInt(100)
SAY range.nextInt(100)
SAY range.nextInt(100)
SAY range.nextInt(100)
SAY

/* The Math Object */
-- Since we can call Java's Math methods, we'll do that here.
SAY Math.PI
SAY Math.E -- Euler's number
SAY Math.cos(Math.PI / 3)
SAY Math.tan(Math.PI / 4)
SAY Math.log(Math.E**2)
SAY (1 + Math.sqrt(5)) / 2 -- golden ratio
